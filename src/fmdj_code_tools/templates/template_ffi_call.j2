void {{ f.name }}FFIHost (
    cudaStream_t stream,
{%- for p in f.par %}
        {%- if p.is_ptr %}
            {%- if p.is_const %}
    ffi::AnyBuffer {{ p.name }}
            {%- else %}
    ffi::Result<ffi:AnyBuffer> {{ p.name }}
            {%- endif %}
        {%- else %}
    {{ p.type }} {{ p.name }}
        {%- endif %},
{%- endfor %}
    size_t grid_size,
    size_t block_size
) {
    {{f.name}}<<< grid_size, block_size, 0, stream >>> (
        {%- for p in f.par %}
            {%- if p.is_ptr %}
                {%- if p.is_const %}
        reinterpret_cast<{{p.type}}*>({{ p.name }}.untyped_data())
                {%- else %}
        reinterpret_cast<{{p.type}}*>({{ p.name }}->untyped_data())
                {%- endif %}
            {%- else %}
        {{ p.name }}
            {%- endif %}
        {{- "," if not loop.last else "" }}
        {%- endfor %}
    );
}

XLA_FFI_DEFINE_HANDLER_SYMBOL(
    {{ f.name }}FFI, {{ f.name }}FFIHost,
    ffi::Ffi::Bind()
        .Ctx<ffi::PlatformStream<cudaStream_t>>()
{%- for p in f.par %}
        {%- if p.is_ptr %}
            {%- if p.is_const %}
        .Arg<ffi::AnyBuffer>(), // {{ p.name }}
            {%- else %}
        .Ret<ffi::AnyBuffer>(), // {{ p.name }}
            {%- endif %}
        {%- else %}
        .Attr<{{p.type}}>("{{ p.name }}"),
        {%- endif %}
{%- endfor %}
        .Attr<size_t>("grid_size"),
        .Attr<size_t>("block_size")
    {xla::ffi::Traits::kCmdBufferCompatible}
);